---
---

<nav class="fixed top-0 left-0 right-0 z-40 glass-strong border-b border-white/10" role="navigation" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="#about" class="text-xl font-bold gradient-text hover:opacity-80 transition-opacity focus:ring-2 focus:ring-primary-500 rounded">
        Luca Smigoski
      </a>
      
      <ul class="hidden md:flex items-center gap-8">
        <li>
          <a 
            href="#experience" 
            class="text-neutral-300 hover:text-white transition-colors focus:ring-2 focus:ring-primary-500 rounded px-2 py-1"
          >
            Experience
          </a>
        </li>
        <li>
          <a 
            href="#skills" 
            class="text-neutral-300 hover:text-white transition-colors focus:ring-2 focus:ring-primary-500 rounded px-2 py-1"
          >
            Skills
          </a>
        </li>
        <li>
          <a 
            href="#contact" 
            class="text-neutral-300 hover:text-white transition-colors focus:ring-2 focus:ring-primary-500 rounded px-2 py-1"
          >
            Contact
          </a>
        </li>
      </ul>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="md:hidden w-10 h-10 flex items-center justify-center glass rounded-lg hover:bg-white/10 transition-all focus:ring-2 focus:ring-primary-500"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden py-4 border-t border-white/10">
      <ul class="space-y-3">
        <li>
          <a 
            href="#experience" 
            class="block text-neutral-300 hover:text-white transition-colors py-2 focus:ring-2 focus:ring-primary-500 rounded"
          >
            Experience
          </a>
        </li>
        <li>
          <a 
            href="#skills" 
            class="block text-neutral-300 hover:text-white transition-colors py-2 focus:ring-2 focus:ring-primary-500 rounded"
          >
            Skills
          </a>
        </li>
        <li>
          <a 
            href="#contact" 
            class="block text-neutral-300 hover:text-white transition-colors py-2 focus:ring-2 focus:ring-primary-500 rounded"
          >
            Contact
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
    });

    // Close menu when clicking a link
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuButton.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
