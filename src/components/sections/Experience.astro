---
const jobs = [
  {
    now: true,
    when: '2026 - now',
    role: 'Founder & CEO',
    company: 'Talkium',
    text: 'Voice, chat and streaming in one native app. Product, company and code, from the Rust media server to the client.',
    tech: ['Rust', 'Axum', 'Tauri', 'SolidJS', 'React Native'],
  },
  {
    when: 'Oct 2024 - now',
    role: 'Software Engineer',
    company: 'Globaltask',
    text: 'Web applications for the audit and compliance sector, handling sensitive data and regulated workflows.',
    tech: ['Angular', '.NET 8', 'Redis', 'MSSQL', 'TypeScript'],
  },
  {
    when: 'Sep 2018 - now',
    role: 'Software Engineer',
    company: 'Freelance',
    text: 'Enterprise systems, a Web3 portfolio tracker, a pet adoption app and AI-powered apps for clients in Argentina and abroad.',
    tech: ['Angular', 'Next.js', 'NestJS', 'Flutter', 'OpenAI'],
  },
  {
    when: 'Mar 2023 - Oct 2024',
    role: 'Software Engineer',
    company: 'Void.gg',
    text: 'Player and match tracking for Counter-Strike 2, OSRS and Fortnite, scraping pipelines, AI content and AWS infrastructure.',
    tech: ['Next.js', 'NestJS', 'Rust', 'Python', 'AWS'],
  },
  {
    when: 'Aug 2022 - Jun 2023',
    role: 'Senior Front-End Developer',
    company: 'Naranja X',
    text: 'Loans, credit cards and virtual bank accounts. Led the front-end team and its architecture decisions.',
    tech: ['Angular', 'TypeScript', 'Node.js'],
  },
  {
    when: 'Oct 2021 - Aug 2022',
    role: 'Full-stack Developer',
    company: 'Epidata',
    text: 'Contracted into Naranja X as a semi-senior front-end developer, then hired directly by them.',
    tech: ['Angular', 'TypeScript', 'Express'],
  },
  {
    when: 'Jul 2021 - Oct 2021',
    role: 'Frontend Developer',
    company: 'Baufest',
    text: 'An internal system for Molinos Agro that tracks and geolocates ships on their export routes.',
    tech: ['Angular', '.NET'],
  },
];
---

<section id="experience" class="section">
  <div class="wrap">
    <p class="kicker" data-r>experience</p>
    <h2 class="h2" data-r style="--d: 60ms">Six years of shipping before Talkium.</h2>
    <div class="jobs">
      {jobs.map((j, i) => (
        <article class:list={['card', 'job', { now: j.now }]} data-r style={`--d: ${(i % 3) * 70}ms`}>
          <p class="when">{j.when}</p>
          <div>
            <h3>{j.role} <span>at {j.company}</span></h3>
            <p>{j.text}</p>
            <div class="chips">{j.tech.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
