---
import ContactForm from '../islands/ContactForm';
---

<section id="contact" class="section">
  <div class="wrap">
    <div class="card contact-card" data-r>
      <div>
        <p class="kicker">contact</p>
        <h2 class="h2">Let's talk.</h2>
        <p class="lead">About Talkium, a project, or a job. I read everything.</p>
        <div class="links">
          <a href="mailto:contact@lucasmigoski.com.ar"><span>contact@lucasmigoski.com.ar</span><span aria-hidden="true">&rarr;</span></a>
          <a href="https://talkium.gg" target="_blank" rel="noopener noreferrer"><span>talkium.gg</span><span aria-hidden="true">&rarr;</span></a>
          <a href="https://github.com/4nything" target="_blank" rel="noopener noreferrer"><span>github.com/4nything</span><span aria-hidden="true">&rarr;</span></a>
          <a href="https://www.linkedin.com/in/luca-smigoski/" target="_blank" rel="noopener noreferrer"><span>linkedin.com/in/luca-smigoski</span><span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <ContactForm client:visible />
    </div>
  </div>
</section>
